# Copy to .env.local for local development. NEVER commit real values.
#
# --- Public (exposed to the browser) ---------------------------------------
# Anything prefixed VITE_ is inlined into the client bundle at build time and
# is visible to every visitor. Never put secrets here.
#
# Optional Cesium ion token (assets:read, URL-restricted to your domains).
# Not required: the default basemap (CARTO/OSM) needs no key.
VITE_CESIUM_ION_TOKEN=

# Optional alternative basemap (https template with {z}/{x}/{y}); default is Esri Canvas.
# Add its host to img-src/connect-src in vercel.json.
VITE_BASEMAP_LIGHT_URL=
VITE_BASEMAP_DARK_URL=
VITE_BASEMAP_ATTRIBUTION=

# --- Server only (Vercel Functions in /api) ---------------------------------
# Optional OpenSky Network account (free, opensky-network.org → Account → API client).
# Without it the worldwide flight snapshot refreshes about every 15 min (anonymous
# budget); with it, about every 90 s. Licence: non-commercial.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional TfL app key: only raises the anonymous rate limit of the JamCam list.
TFL_APP_KEY=

# Provider kill switches ("0" disables a source; default enabled).
SOURCE_DGT_ENABLED=1
SOURCE_MADRID_ENABLED=1
SOURCE_TFL_ENABLED=1
SOURCE_FINTRAFFIC_ENABLED=1
SOURCE_FLIGHTS_ENABLED=1

# Best-effort per-instance limit for /api/frame requests per client per minute.
FRAME_RATE_LIMIT_PER_MIN=240
