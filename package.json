  "description": "WORLDVIEW ESPAÑA — explorador de cámaras públicas sobre un globo 3D CesiumJS, con sección dedicada a España.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "dev": "vite",
